{
  "services": {
    "default": {
      "image": "beat-stockfish:local",
      "x-local": true,
      "init": true,
      "network_mode": "none",
      "dns": [
        "127.0.0.1"
      ],
      "dns_search": [
        "."
      ],
      "command": [
        "tail",
        "-f",
        "/dev/null"
      ],
      "cpus": 2,
      "mem_limit": "4g",
      "memswap_limit": "4g",
      "pids_limit": 4096
    }
  }
}
