        "command": "cat > /workdir/think.py <<'PY'\nimport chess,time,sys\nV=[0,100,320,335,500,950,20000]; TT={}; nodes=0; start=time.time()\nfen=sys.argv[1]; b=chess.Board(fen)\ndef ev(b):\n s=0\n for c in [True,False]:\n  z=1 if c else -1\n  for p in range(1,7):\n   for sq in b.pieces(p,c):\n    r=chess.square_rank(sq) if c else 7-chess.square_rank(sq); f=chess.square_file(sq); cen=3.5-abs(f-3.5)+3.5-abs(r-3.5)\n    val=V[p]\n    if p==1: val+=r*5+ (15 if r>=4 else 0)\n    if p==2: val+=cen*7\n    if p==3: val+=cen*3\n    if p==4: val+=r*2\n    s+=z*val\n return s if b.turn else -s\n\ndef order(b,m,tt=None):\n if m==tt:return 100000\n v=0\n if b.is_capture(m):v=10000+V[b.piece_type_at(m.to_square) or 1]*10-V[b.piece_type_at(m.from_square)]\n if m.promotion:v+=10000\n if b.gives_check(m):v+=1000\n return v\n\ndef search(b,d,a,z,ply=0,qleft=7):\n global nodes\n nodes+=1\n if b.is_checkmate():return -100000+ply,[]\n if b.is_stalemate() or b.is_insufficient_material():return 0,[]\n check=b.is_check(); key=b._transposition_key(); old=TT.get(key); orig=a\n if d>0 and old and old[0]>=d:\n  dep,val,flag,m=old\n  if flag==0 or (flag==1 and val>=z) or(flag==-1 and val<=a):return val,[m] if m else []\n moves=list(b.legal_moves)\n if d<=0 and not check:\n  stand=ev(b)\n  if stand>=z:return stand,[]\n  a=max(a,stand)\n  if qleft<=0:return a,[]\n  moves=[m for m in moves if b.is_capture(m) or m.promotion]\n if d<=0 and qleft<=-3:return ev(b),[]\n moves.sort(key=lambda m:order(b,m,old[3] if old else None),reverse=True)\n best=-1000000 if d>0 or check else a; pv=[]; bm=None\n for m in moves:\n  b.push(m); sc,line=search(b,d-1,-z,-a,ply+1,qleft-1 if d<=0 else qleft); sc=-sc;b.pop()\n  if sc>best:best=sc;bm=m;pv=[m]+line\n  a=max(a,sc)\n  if a>=z:break\n if d>0:TT[key]=(d,best,1 if best>=z else -1 if best<=orig else 0,bm)\n return best,pv\nfor d in range(1,int(sys.argv[2])+1):\n results=[]\n for m in sorted(b.legal_moves,key=lambda m:order(b,m),reverse=True):\n  b.push(m);sc,pv=search(b,d-1,-1000000,1000000);b.pop();results.append((-sc,m,[m]+pv))\n results.sort(key=lambda x:x[0],reverse=True)\n print('depth',d,'nodes',nodes,'secs',round(time.time()-start,1),flush=True)\n for s,m,pv in results[:10]:print(s,' '.join(x.uci() for x in pv),flush=True)\nPY\ncd /workdir && python3 think.py '5rk1/3b3p/7r/pPbP1ppq/R4Q1P/2NB4/1P4P1/5R1K w - - 0 30' 3"
