        "command": "cat > auto.py <<'PY'\nimport socket,sys,time\nimport arena,chess\ns=socket.socket(socket.AF_UNIX);s.connect('/run/match/opponent-stockfish.sock');f=s.makefile('r')\ndef send(x):s.sendall((x+'\\n').encode())\nsend('uci')\nfor l in f:\n if l.strip()=='uciok':break\nsend('setoption name Threads value 2');send('setoption name Hash value 256');send('isready')\nfor l in f:\n if l.strip()=='readyok':break\nfor i in range(int(sys.argv[1])):\n b=arena.load_board()\n if arena.result(b):print('RESULT',arena.result(b));break\n print('MOVE',b.fullmove_number, 'FEN',b.fen(),flush=True)\n legal=[]\n for m in b.legal_moves:\n  b.push(m)\n  if not b.is_repetition(2):legal.append(m.uci())\n  b.pop()\n send('position startpos moves '+' '.join(m.uci() for m in b.move_stack))\n send('go movetime 30000'+(' searchmoves '+' '.join(legal) if len(legal)!=b.legal_moves.count() and legal else ''))\n for l in f:\n  if l.startswith('info depth') and ' pv ' in l:last=l.strip()\n  if l.startswith('bestmove'):\n   best=l.split()[1];break\n print(last,flush=True)\n print('PLAY',best,flush=True)\n if 'score cp' in last and int(last.split('score cp ')[1].split()[0]) < -80:\n  print('PAUSING NEGATIVE');break\n b=arena._request('move '+best)\n print('REPLY',b.peek().uci(),flush=True)\n if arena.result(b):print('RESULT',arena.result(b),flush=True);break\nsend('quit')\nPY\npython3 auto.py 8 | tee batch.log"
