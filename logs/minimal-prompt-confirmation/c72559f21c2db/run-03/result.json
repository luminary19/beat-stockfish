ush(m)\n return ' '.join(line)\nif __name__=='__main__':\n b=chess.Board(sys.argv[1]);secs=int(sys.argv[2]) if len(sys.argv)>2 else 60\n start=time.time();limit=start+secs;sc=score(b)\n for dep in range(1,15):\n  try:\n   ev=search(b,dep,-31000,31000,sc,0,True)\n   print(dep,ev,'nodes',N,'time',round(time.time()-start,1),pvline(b),flush=True)\n  except Timeout:break\nPY\ncd /workdir && python3 think.py '3q1rk1/5ppp/3pb3/R2Np1bQ/8/2PnN3/1r4PP/R5K1 w - - 0 25' 100"
