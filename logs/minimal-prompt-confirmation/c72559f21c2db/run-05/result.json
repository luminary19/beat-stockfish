t(key); ttm=ent[3][0] if ent and ent[3] else None\n orig=a\n if ent and ent[0]>=d:\n  dep,v,flag,pv=ent\n  if flag==0 or flag==1 and v>=be or flag==-1 and v<=a:return v,pv\n moves=sorted(b.legal_moves,key=lambda m:order(b,m,ttm),reverse=True)\n if not moves:return (-100000+ply if b.is_check() else 0),[]\n best=-1e9; pv=[]\n for m in moves:\n  b.push(m);v,line=search(b,d-1,-be,-a,ply+1);v=-v;b.pop()\n  if v>best:best=v;pv=[m]+line\n  if v>a:a=v\n  if a>=be:break\n tt[key]=(d,best,1 if best>=be else -1 if best<=orig else 0,pv)\n return best,pv\nb=chess.Board(sys.argv[1]); maxd=int(sys.argv[2])\nfor d in range(1,maxd+1):\n try:\n  v,pv=search(b,d,-1e9,1e9)\n  bb=b.copy(); ss=[]\n  for m in pv:ss.append(bb.san(m));bb.push(m)\n  print(d,v,' '.join(ss),'nodes',nodes,'time',time.time()-start,flush=True)\n except TimeoutError:break\nPY\ncd /workdir && python3 think.py '1r2r1k1/3b2pp/8/pP1P1p2/Rb2N2q/3B4/1P2QPPP/R5K1 w - - 0 27' 5 100"
